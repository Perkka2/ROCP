<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS: same rules as .htaccess. Files only read by the control panel itself are never served,
     and the install/upgrade folders are hidden. -->
<configuration>
	<system.webServer>
		<security>
			<requestFiltering>
				<fileExtensions allowUnlisted="true">
					<add fileExtension=".sql" allowed="false" />
					<add fileExtension=".txt" allowed="false" />
					<add fileExtension=".def" allowed="false" />
					<add fileExtension=".inc" allowed="false" />
					<add fileExtension=".tmp" allowed="false" />
					<add fileExtension=".dll" allowed="false" />
					<add fileExtension=".md" allowed="false" />
					<add fileExtension=".bak" allowed="false" />
					<add fileExtension=".log" allowed="false" />
					<add fileExtension=".zip" allowed="false" />
					<add fileExtension=".rar" allowed="false" />
					<add fileExtension=".7z" allowed="false" />
				</fileExtensions>
				<hiddenSegments>
					<add segment="install" />
					<add segment="upgrade" />
				</hiddenSegments>
			</requestFiltering>
		</security>
	</system.webServer>
</configuration>
